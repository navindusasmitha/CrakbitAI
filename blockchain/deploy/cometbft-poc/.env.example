# Local-only v0.14 external-consensus PoC.
# Replace token locally. Never commit a real token.
CRAKBIT_EXECUTION_URL=http://127.0.0.1:26659
CRAKBIT_EXECUTION_TOKEN=REPLACE_WITH_LONG_RANDOM_SECRET
CRAKBIT_ABCI_LISTEN=tcp://127.0.0.1:26658

# The Python service should use a dedicated data directory:
CRAKBIT_EXTERNAL_DATA_DIR=runtime/comet-app
