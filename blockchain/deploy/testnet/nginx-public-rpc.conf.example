# Development/public-testnet example only. Review for your host before use.
# Keep validator /internal/* routes off the public Internet.

limit_req_zone $binary_remote_addr zone=crakbit_tx:10m rate=10r/s;
limit_conn_zone $binary_remote_addr zone=crakbit_conn:10m;

server {
    listen 443 ssl http2;
    server_name rpc.example.invalid;

    ssl_certificate     /etc/nginx/tls/rpc.crt;
    ssl_certificate_key /etc/nginx/tls/rpc.key;
    ssl_protocols TLSv1.2 TLSv1.3;

    client_max_body_size 256k;
    client_body_timeout 10s;
    keepalive_timeout 20s;
    limit_conn crakbit_conn 20;

    location ^~ /internal/ {
        return 404;
    }

    location = /transactions {
        limit_req zone=crakbit_tx burst=20 nodelay;
        proxy_pass http://127.0.0.1:9101;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location / {
        proxy_pass http://127.0.0.1:9101;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }
}
